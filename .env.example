# ShadowGrid AI — Environment Variables
# Copy this file to .env and fill in the values you want to use.
# The app runs fully in demo/mock mode without any of these keys.
#
# ─── REQUIRED for Supabase persistence ───────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── OPTIONAL — NewsAPI live news signal ingestion ───────────────────────────
# Free tier: https://newsapi.org  (~100 req/day)
# LOCAL DEV ONLY: NewsAPI allows direct browser calls from localhost.
# DO NOT set this for a public/production build — VITE_ vars are bundled into
# the client and would expose your key. Use the proxy below instead.
# VITE_NEWS_API_KEY=your-newsapi-key

# ─── OPTIONAL — NewsAPI CORS proxy ───────────────────────────────────────────
# NewsAPI's free tier blocks direct browser requests on public domains.
# Point this at a server-side proxy that forwards to newsapi.org. Two options:
#   • Supabase Edge Function (recommended — works regardless of frontend host):
#       supabase/functions/news-proxy/index.ts is included in this repo.
#       Deploy it, set the NEWS_API_KEY secret on the function, then use:
#       VITE_NEWS_API_PROXY_URL=https://<project-ref>.supabase.co/functions/v1/news-proxy
#   • Vercel API route: VITE_NEWS_API_PROXY_URL=/api/news-proxy
# Not needed for local dev (localhost is allowed) or Demo mode.
# VITE_NEWS_API_PROXY_URL=https://your-project-ref.supabase.co/functions/v1/news-proxy

# ─── OPTIONAL — Open-Meteo override (for tests/CI mock server) ───────────────
# VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ─── App identity ─────────────────────────────────────────────────────────────
VITE_DEMO_CITY=Metroville
